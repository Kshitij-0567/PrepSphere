# Copy to backend/.env and fill in the values.

# Database. Defaults to the SQLite file backend/interview_prep.db when unset.
# PostgreSQL example: postgresql://user:password@localhost:5432/prepsphere
DATABASE_URL=sqlite:///./interview_prep.db

# Required. Signs login tokens; generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# How long a login lasts, in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional. Without it the app still works, using clearly labelled keyword-based fallbacks.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_SECONDS=30

# Optional. OAuth client ID for "Sign in with Google"; must match VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Optional. GitHub token (no scopes needed) raises the GitHub import limit from 60 to 5,000 requests/hour.
GITHUB_TOKEN=

# Comma-separated list of frontend origins allowed to call the API. "*" is refused;
# production origins must use https://.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# "development" or "production". Production (set by the Docker image) hides the API docs,
# turns off demo login unless DEMO_LOGIN_ENABLED=true, sends HSTS and refuses unsafe settings.
APP_ENV=development
# "Try demo" button: creates a throwaway account per visitor. Defaults to off in production.
DEMO_LOGIN_ENABLED=true
# Interactive API docs at /docs. Defaults to off in production.
# ENABLE_API_DOCS=true
# Per-address and per-account request limits. Leave on outside of automated tests.
RATE_LIMITS_ENABLED=true
# Behind a reverse proxy (nginx, a cloud load balancer), set this to the proxy's IP address so
# rate limits apply to each visitor rather than to the proxy as a whole.
# FORWARDED_ALLOW_IPS=10.0.0.5
MAX_RESUME_MB=10
# Size limit for one video-interview answer's audio (16 kHz WAV is about 2 MB a minute).
MAX_ANSWER_AUDIO_MB=16

# Where `python main.py` listens, and whether it restarts when code changes (development only).
# HOST=127.0.0.1
# PORT=8000
# RELOAD=true
# Database migrations run when the app starts. Set to false only if you run `alembic upgrade head` yourself.
# RUN_MIGRATIONS_ON_STARTUP=true
