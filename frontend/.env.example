# Copy to frontend/.env
# Backend base URL (no trailing slash). Leave empty when the backend serves the frontend (Docker).
VITE_API_URL=http://localhost:8000

# Optional: OAuth client ID for "Sign in with Google"; must match GOOGLE_CLIENT_ID in backend/.env.
# The Google button is hidden when this is empty.
VITE_GOOGLE_CLIENT_ID=

# Never put API keys here: every VITE_ variable is embedded in the public JavaScript bundle.
